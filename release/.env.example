# Saki Panel 环境变量配置示例
# 复制此文件为 .env 并修改为实际值

# JWT 密钥（生产环境必须修改）
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Daemon 注册令牌（生产环境必须修改）
DAEMON_REGISTRATION_TOKEN=your-daemon-registration-token-here

# Panel 配置
PANEL_HOST=0.0.0.0
PANEL_PORT=5479
PANEL_PUBLIC_URL=http://localhost:5479

# Web 配置
WEB_ORIGIN=http://localhost:5478
VITE_API_BASE_URL=http://localhost:5479

# 数据库配置
DATABASE_URL=file:../data/panel/dev.db

# CORS 配置
PANEL_CORS_ORIGINS=*

# 禁用认证（仅用于开发调试）
DISABLE_AUTH=0
