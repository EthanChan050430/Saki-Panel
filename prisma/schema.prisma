generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/panel/dev.db"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum NodeStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum OperationResult {
  SUCCESS
  FAILURE
}

enum InstanceStatus {
  CREATED
  STARTING
  RUNNING
  STOPPING
  STOPPED
  CRASHED
  UNKNOWN
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  passwordHash        String
  displayName         String
  avatarDataUrl       String?
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  roles               UserRole[]
  logs                OperationLog[]
  createdInstances    Instance[]           @relation("InstanceCreator")
  assignedInstances   Instance[]           @relation("InstanceAssignee")
  instanceAssignments InstanceAssignment[]
  createdNodes        Node[]               @relation("NodeCreator")
  createdEnrollmentTokens NodeEnrollmentToken[] @relation("EnrollmentTokenCreator")
  accessKeys          UserAccessKey[]
  points              Int                  @default(0)
  unlimitedPoints     Boolean              @default(false)
  favorability        Int                  @default(0)
  pointRecords        PointRecord[]
  sakiConversations   SakiConversation[]
  createdTemplates    Template[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Node {
  id         String          @id @default(cuid())
  name       String
  host       String
  port       Int
  protocol   String          @default("http")
  tokenHash  String
  tokenLast4 String
  status     NodeStatus      @default(UNKNOWN)
  os         String?
  arch       String?
  version    String?
  remarks    String?
  groupName  String?
  tags       String?
  lastSeenAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  metrics    NodeMetric[]
  instances  Instance[]
  tasks      ScheduledTask[]
  createdById String?
  createdBy   User?           @relation("NodeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([host, port])
  @@index([createdById])
  @@map("nodes")
}

model NodeMetric {
  id            String   @id @default(cuid())
  nodeId        String
  cpuUsage      Float
  memoryUsage   Float
  diskUsage     Float
  totalMemoryMb Int?
  usedMemoryMb  Int?
  totalDiskGb   Float?
  usedDiskGb    Float?
  uptimeSeconds Int?
  loadAverage1m Float?
  createdAt     DateTime @default(now())
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("node_metrics")
}

model NodeEnrollmentToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  tokenLast4  String
  namePrefix  String?
  groupName   String?
  tags        String?
  maxUsage    Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("EnrollmentTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([createdById])
  @@map("node_enrollment_tokens")
}

model OperationLog {
  id           String          @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  userAgent    String?
  payload      String?
  result       OperationResult @default(SUCCESS)
  createdAt    DateTime        @default(now())
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@map("operation_logs")
}

model Instance {
  id                String               @id @default(cuid())
  nodeId            String
  name              String
  type              String               @default("generic_command")
  workingDirectory  String
  startCommand      String
  stopCommand       String?
  status            InstanceStatus       @default(CREATED)
  autoStart         Boolean              @default(false)
  restartPolicy     String               @default("never")
  restartMaxRetries Int                  @default(0)
  runAsUser         String?
  memoryLimit       Int?
  cpuLimit          Float?
  description       String?
  proxyConfig       String?
  createdById       String?
  assignedToId      String?
  lastStartedAt     DateTime?
  lastStoppedAt     DateTime?
  lastExitCode      Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  node              Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdBy         User?                @relation("InstanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo        User?                @relation("InstanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedUsers     InstanceAssignment[]
  tasks             ScheduledTask[]
  watchPolicy       WatchPolicy?
  incidents         Incident[]
  ingestTokens      IngestToken[]

  @@index([nodeId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@map("instances")
}

model Template {
  id                            String   @id @default(cuid())
  name                          String
  description                   String?
  type                          String   @default("generic_command")
  defaultStartCommand           String   @default("")
  defaultStopCommand            String?
  defaultWorkingDirectoryPrefix String   @default("instances")
  portsJson                     String?                                  // JSON: Array<{port, description}>
  envsJson                      String?                                  // JSON: Array<{key, value}>
  autoStart                     Boolean  @default(false)
  restartPolicy                 String   @default("never")
  restartMaxRetries             Int      @default(0)
  runAsUser                     String?
  memoryLimit                   Int?
  cpuLimit                      Float?
  fromInstanceId                String?
  isBuiltin                     Boolean  @default(false)                 // built-in templates ship with the app
  createdById                   String?
  createdBy                     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([createdById])
  @@map("templates")
}

model InstanceAssignment {
  instanceId String
  userId     String
  assignedAt DateTime @default(now())
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([instanceId, userId])
  @@index([userId])
  @@map("instance_assignments")
}

model WatchPolicy {
  instanceId                String   @id
  enabled                   Boolean  @default(true)
  mode                      String   @default("diagnose_and_patch")
  cooldownSeconds           Int      @default(900)
  maxRunsPerHour            Int      @default(3)
  verifyWaitSeconds         Int      @default(20)
  approverUserId            String?
  // 风险分级自治：诊断 risk <= autoApproveRisk 且 confidence >= autoApproveMinConfidence 时自动批准执行
  autoApproveRisk           String   @default("none") // none | low | medium
  autoApproveMinConfidence  Float    @default(0.85)
  // 修复后健康检查：verify 阶段除状态/日志外，额外探测该 URL 返回 2xx 才算通过
  healthCheckUrl            String?
  healthCheckTimeoutSeconds Int      @default(5)
  // 通知外送与升级：JSON 数组存渠道 id；awaiting_approval 超过 escalationMinutes 未处理触发升级通知
  notifyChannelIds          String   @default("[]")
  escalationMinutes         Int      @default(30)
  updatedAt                 DateTime @updatedAt
  instance                  Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("watch_policies")
}

model Incident {
  id              String    @id @default(cuid())
  instanceId      String
  nodeId          String
  fingerprint     String
  trigger         String
  status          String
  exitCode        Int?
  summary         String?
  rootCause       String?
  proposedPatch   String?
  logTail         String    @default("")
  rollbackSet     String?
  taskId          String?
  assigneeUserId  String?
  occurrenceCount Int       @default(1)
  lastOccurredAt  DateTime  @default(now())
  resolvedAt      DateTime?
  ignoredUntil    DateTime?
  // 降噪与复发：groupKey 用于跨实例/跨事件分组（如 node:disk:小时桶），recurrenceCount 是同指纹历史复发次数
  groupKey        String?
  recurrenceCount Int       @default(0)
  flapping        Boolean   @default(false)
  // 诊断证据包（JSON：WatchEvidence）与自治/通知轨迹
  evidenceJson    String?
  autoApplied     Boolean   @default(false)
  escalatedAt     DateTime?
  lastNotifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  instance        Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, fingerprint])
  @@index([status, updatedAt])
  @@index([assigneeUserId, status])
  @@index([groupKey])
  @@map("incidents")
}

// 静默规则：匹配的事件直接吞掉（instanceId/fingerprint/trigger 任一组合，expiresAt 为空表示永久）
model SilenceRule {
  id          String    @id @default(cuid())
  instanceId  String?
  fingerprint String?
  trigger     String?
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([instanceId])
  @@index([fingerprint])
  @@map("silence_rules")
}

// 出站通知渠道：webhook(通用 JSON) / dingtalk / wecom / telegram
model NotificationChannel {
  id          String                 @id @default(cuid())
  name        String
  type        String
  url         String
  secret      String?
  enabled     Boolean                @default(true)
  eventsJson  String                 @default("[]") // 订阅的事件类别: ["opened","awaiting","resolved","failed","escalation"]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deliveries  NotificationDelivery[]

  @@map("notification_channels")
}

model NotificationDelivery {
  id         String              @id @default(cuid())
  channelId  String
  incidentId String?
  kind       String // opened | awaiting | resolved | failed | escalation | test
  status     String // success | failure
  error      String?
  createdAt  DateTime            @default(now())
  channel    NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([channelId])
  @@map("notification_deliveries")
}

// 外部告警接入口令：Prometheus Alertmanager / Grafana / 任意监控系统 POST 告警进来
model IngestToken {
  id         String    @id @default(cuid())
  instanceId String
  label      String    @default("")
  token      String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  instance   Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("ingest_tokens")
}

model ScheduledTask {
  id         String    @id
  nodeId     String?
  instanceId String?
  name       String
  type       String
  cron       String
  payload    String?
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  node       Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  runs       TaskRun[]

  @@index([enabled, nextRunAt])
  @@index([instanceId])
  @@map("scheduled_tasks")
}

model TaskRun {
  id         String        @id
  taskId     String
  status     String
  output     String?
  error      String?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  task       ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("task_runs")
}

model UserAccessKey {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("默认访问密钥")
  keyHash    String    @unique
  keyLast4   String
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_access_keys")
}

model PointRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int?
  type         String
  tokensUsed   Int?
  description  String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("point_records")
}

model SakiConversation {
  id         String   @id
  userId     String
  contextKey String
  title      String
  label      String   @default("Saki")
  detail     String   @default("")
  instanceId String?
  messages   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, contextKey])
  @@map("saki_conversations")
}
