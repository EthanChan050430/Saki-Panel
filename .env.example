PANEL_PORT=5479
PANEL_HOST=0.0.0.0
PANEL_PUBLIC_URL=http://localhost:5479
WEB_ORIGIN=http://localhost:5478
PANEL_CORS_ORIGINS=*
VITE_HOST=0.0.0.0
VITE_ALLOWED_HOSTS=*
VITE_API_BASE_URL=
DATABASE_URL=file:../data/panel/dev.db
JWT_SECRET=change-me-before-production
DISABLE_AUTH=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
DAEMON_REGISTRATION_TOKEN=dev-registration-token

DAEMON_PORT=5480
DAEMON_HOST=127.0.0.1
# Optional address registered to Panel. Leave empty for same-host installs; set this for remote daemons.
# DAEMON_PUBLIC_HOST=
DAEMON_NAME=Local Daemon
DAEMON_PANEL_URL=http://localhost:5479
DAEMON_PROTOCOL=http
DAEMON_HEARTBEAT_SECONDS=10

# Maximum file transfer size limit for uploads/downloads/compress (in MB). Default is 100.
# MAX_TRANSFER_LIMIT_MB=100

# Optional automatic HTTPS. When ./ssl contains a certificate and private key,
# Panel, Daemon and the Vite dev server start with HTTPS on the same ports.
# SSL_DIR=ssl
# SSL_CERT_FILE=ssl/fullchain.pem
# SSL_KEY_FILE=ssl/privkey.pem
# SSL_CA_FILE=ssl/ca_bundle.pem

# Backend logging: warn keeps routine request/heartbeat logs out of the terminal.
# Set LOG_LEVEL=info or debug when you need detailed request logs.
LOG_LEVEL=warn

# Optional Saki copilot defaults. Panel calls the configured model provider directly.
# SAKI_PROVIDER=ollama
# SAKI_MODEL=llama3
# SAKI_OLLAMA_URL=http://localhost:11434
# SAKI_REQUEST_TIMEOUT_MS=180000

# Optional GitHub OAuth device login for GitHub Copilot.
# Create a GitHub OAuth App, enable Device Flow, then put its Client ID here.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_SCOPE=read:user
