+function watchHealthCheckTarget(value: string | null | undefined): string {
+  if (!value) return "(not configured)";
+  try {
+    const url = new URL(value);
+    url.username = "";
+    url.password = "";
+    url.search = "";
+    url.hash = "";
+    return url.toString();
+  } catch {
+    return "(invalid health check URL)";
+  }
