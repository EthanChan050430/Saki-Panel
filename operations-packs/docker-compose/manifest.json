{
  "schemaVersion": 1,
  "id": "docker-compose-service-guardian",
  "name": "Docker Compose 服务守护",
  "summary": "面向小型 SaaS 与自托管服务的安全诊断、升级、验证和回滚 Runbook。",
  "category": "docker_compose",
  "version": "1.0.0",
  "description": "按需下载的 Docker Compose 运维包。不包含镜像、Compose 文件、凭据或备份数据；安装后仅把已校验的 Runbook、模板和策略建议缓存到控制面，所有实际命令仍由用户审批。",
  "tags": ["docker", "compose", "self-hosted", "deployment", "backup", "rollback"],
  "defaultResourceIds": [
    "compose-operations-skill",
    "compose-service-template",
    "compose-watch-profile",
    "compose-preflight-checklist"
  ],
  "capabilities": [
    {
      "id": "compose-preflight",
      "name": "部署前检查",
      "description": "发现 Compose 文件、变量、服务、端口、卷和健康检查缺口。",
      "kind": "preflight",
      "risk": "low"
    },
    {
      "id": "compose-diagnostics",
      "name": "故障诊断",
      "description": "基于 compose config、状态、日志和健康检查定位最小修复。",
      "kind": "diagnostic",
      "risk": "low"
    },
    {
      "id": "compose-safe-deploy",
      "name": "受控部署",
      "description": "在备份、Diff、验证和回滚点齐备后，逐服务执行升级。",
      "kind": "deployment",
      "risk": "high"
    },
    {
      "id": "compose-rollback",
      "name": "可验证回滚",
      "description": "回到记录的 Compose 与镜像版本，并验证服务恢复。",
      "kind": "rollback",
      "risk": "high"
    }
  ],
  "resources": [
    {
      "id": "compose-operations-skill",
      "kind": "skill",
      "path": "compose-operations.SKILL.md",
      "name": "Docker Compose 安全运维 Skill",
